[0.009933, "o", "\r\n════════════════════════════════════════════════════════════\r\n  Hardened Diagnostic Gateway — demonstration\r\n════════════════════════════════════════════════════════════\r\n"]
[1.212262, "o", "  Pile de diagnostic automobile en C : ISO-TP, UDS, ECU virtuel.\r\n  Bus CAN virtuel : vcan0\r\n"]
[3.214431, "o", "\r\n════════════════════════════════════════════════════════════\r\n  1. Les tests\r\n════════════════════════════════════════════════════════════\r\n"]
[4.478466, "o", "   Tests unitaires ISO-TP Single Frame\r\n   2480 verifications, 0 echec(s)\r\n   Tests ISO-TP multi-trames\r\n   4914 verifications, 0 echec(s)\r\n   Tests unitaires serveur UDS\r\n   7284 verifications, 0 echec(s)\r\n   Tests unitaires donnees ECU virtuel\r\n   55 verifications, 0 echec(s)\r\n"]
[6.480839, "o", "\r\n════════════════════════════════════════════════════════════\r\n  2. Les invariants d'architecture\r\n════════════════════════════════════════════════════════════\r\n"]
[7.685417, "o", "  == I1 : aucun header systeme dans les couches protocole ==\r\n"]
[7.688441, "o", "  OK\r\n"]
[7.688922, "o", "  == I2 : aucune allocation dynamique dans src/ ==\r\n"]
[7.691519, "o", "  OK\r\n"]
[7.691982, "o", "  == I1bis : les couches protocole compilent hors contexte Linux ==\r\n"]
[7.79312, "o", "  OK\r\n"]
[7.7935, "o", "  == I1ter : couches protocole sous -Wconversion et -Wshadow ==\r\n"]
[7.865394, "o", "  OK\r\n"]
[7.865809, "o", "  == I1quater : couches protocole compilables sans libc ni OS ==\r\n"]
[7.935196, "o", "  OK\r\n"]
[7.935725, "o", "  == I2bis : aucun symbole d'allocation dans les binaires ==\r\n"]
[7.943498, "o", "  OK\r\n"]
[10.44583, "o", "\r\n════════════════════════════════════════════════════════════\r\n  3. Dialogue avec l'ECU virtuel\r\n════════════════════════════════════════════════════════════\r\n"]
[13.15251, "o", "=== Client de diagnostic ===\r\ninterface vcan0   requetes 0x7E0   reponses 0x7E8\r\n\"help\" pour la liste des commandes.\r\n\r\n[DEFAULT | LOCKED] > # --- La session par defaut ne donne acces a rien de sensible ---\r\n\r\n[DEFAULT | LOCKED] > "]
[13.754992, "o", "present\r\n  TX  3E 00 \r\n"]
[13.755063, "o", "  RX  7E 00 \r\n      OK     TesterPresent\r\n\r\n[DEFAULT | LOCKED] > "]
[14.357472, "o", "reset\r\n  TX  11 01 \r\n"]
[14.357512, "o", "  RX  7F 11 7F \r\n      REFUS  ECUReset -> NRC 0x7F  serviceNotSupportedInActiveSession\r\n\r\n[DEFAULT | LOCKED] > "]
[14.959685, "o", "# --- On ouvre une session etendue ---\r\n\r\n[DEFAULT | LOCKED] > "]
[15.562934, "o", "session extended\r\n  TX  10 03 \r\n"]
[15.563019, "o", "  RX  50 03 00 32 01 F4 \r\n      OK     session EXTENDED\r\n             P2 50 ms, P2* 5000 ms\r\n\r\n[EXTENDED | LOCKED] > "]
[16.165477, "o", "# --- Lectures : identification, puis grandeurs vives ---\r\n\r\n[EXTENDED | LOCKED] > "]
[16.768163, "o", "read sw\r\n  TX  22 F1 89 \r\n"]
[16.768206, "o", "  RX  62 F1 89 01 04 02 \r\n      OK     DID F189  ECU software version\r\n             01 04 02 \r\n\r\n[EXTENDED | LOCKED] > "]
[17.37112, "o", "read rpm\r\n  TX  22 01 00 \r\n"]
[17.37127, "o", "  RX  62 01 00 05 CD \r\n      OK     DID 0100  engine RPM\r\n             05 CD  = 1485 tr/min\r\n\r\n[EXTENDED | LOCKED] > "]
[17.973416, "o", "read temp\r\n  TX  22 01 02 \r\n"]
[17.973458, "o", "  RX  62 01 02 00 1B \r\n      OK     DID 0102  coolant temperature\r\n             00 1B  = 27 C\r\n\r\n[EXTENDED | LOCKED] > "]
[18.575352, "o", "# --- Le VIN fait 17 octets : ISO-TP le transporte en plusieurs trames ---\r\n\r\n[EXTENDED | LOCKED] > "]
[19.177612, "o", "read vin\r\n  TX  22 F1 90 \r\n"]
[19.177876, "o", "  RX  62 F1 90 56 46 31 48 44 47 32 41 58 34 37 31 32 39 33 30 35 \r\n      OK     DID F190  VIN\r\n             56 46 31 48 44 47 32 41 58 34 37 31 32 39 33 30 35  = \"VF1HDG2AX47129305\"\r\n\r\n[EXTENDED | LOCKED] > "]
[19.78084, "o", "# --- Memoire de defauts ---\r\n\r\n[EXTENDED | LOCKED] > "]
[20.383127, "o", "dtc\r\n  TX  19 02 09 \r\n"]
[20.383175, "o", "  RX  59 02 09 01 17 00 09 C1 23 45 08 01 62 00 09 \r\n      OK     3 code(s) defaut\r\n             011700  statut 09  capteur de temperature moteur\r\n             C12345  statut 08  defaut de communication reseau\r\n             016200  statut 09  sous-tension batterie\r\n\r\n[EXTENDED | LOCKED] > "]
[20.985506, "o", "# --- Session ouverte, mais la commande sensible reste verrouillee ---\r\n\r\n[EXTENDED | LOCKED] > "]
[21.58806, "o", "reset\r\n  TX  11 01 \r\n"]
[21.588101, "o", "  RX  7F 11 33 \r\n      REFUS  ECUReset -> NRC 0x33  securityAccessDenied\r\n\r\n[EXTENDED | LOCKED] > "]
[22.19032, "o", "# --- SecurityAccess : graine, mauvaise cle, nouvelle graine, bonne cle ---\r\n\r\n[EXTENDED | LOCKED] > "]
[22.792921, "o", "seed\r\n  TX  27 01 \r\n"]
[22.792996, "o", "  RX  67 01 81 6D F3 2B \r\n      OK     graine 816DF32B\r\n             cle attendue : 627EF0AD   (\"key\" pour l'envoyer)\r\n\r\n[EXTENDED | LOCKED] > "]
[23.396292, "o", "key DEADBEEF\r\n  TX  27 02 DE AD BE EF \r\n  RX  7F 27 35 \r\n      REFUS  SecurityAccess -> NRC 0x35  invalidKey\r\n\r\n[EXTENDED | LOCKED] > "]
[23.999518, "o", "seed\r\n  TX  27 01 \r\n  RX  67 01 50 E3 99 0C \r\n      OK     graine 50E3990C\r\n             cle attendue : E66E218B   (\"key\" pour l'envoyer)\r\n\r\n[EXTENDED | LOCKED] > "]
[24.601598, "o", "key\r\n  TX  27 02 E6 6E 21 8B \r\n  RX  67 02 \r\n      OK     ACCES DEVERROUILLE\r\n\r\n[EXTENDED | UNLOCKED] > "]
[25.204165, "o", "# --- Rejeu immediat de la meme cle : la graine a ete consommee ---\r\n\r\n[EXTENDED | UNLOCKED] > "]
[25.806712, "o", "key\r\n  TX  27 02 E6 6E 21 8B \r\n"]
[25.806752, "o", "  RX  7F 27 22 \r\n      REFUS  SecurityAccess -> NRC 0x22  conditionsNotCorrect\r\n\r\n[EXTENDED | UNLOCKED] > "]
[26.408763, "o", "# --- Operations desormais autorisees ---\r\n\r\n[EXTENDED | UNLOCKED] > "]
[27.011916, "o", "clear\r\n  TX  14 FF FF FF \r\n  RX  54 \r\n      OK     defauts effaces\r\n\r\n[EXTENDED | UNLOCKED] > "]
[27.614385, "o", "dtc\r\n  TX  19 02 09 \r\n"]
[27.61458, "o", "  RX  59 02 09 \r\n      OK     0 code(s) defaut\r\n\r\n[EXTENDED | UNLOCKED] > "]
[28.216576, "o", "reset\r\n  TX  11 01 \r\n"]
[28.216722, "o", "  RX  51 01 \r\n      OK     calculateur reinitialise\r\n\r\n[DEFAULT | LOCKED] > "]
[28.819137, "o", "# --- Le reset a tout reverrouille ---\r\n\r\n[DEFAULT | LOCKED] > "]
[29.421867, "o", "reset\r\n  TX  11 01 \r\n  RX  7F 11 7F \r\n      REFUS  ECUReset -> NRC 0x7F  serviceNotSupportedInActiveSession\r\n\r\n[DEFAULT | LOCKED] > "]
[30.023957, "o", "stats\r\n\r\n  Reception ISO-TP\r\n    trames recues        : 22\r\n    messages reassembles : 18\r\n    trames rejetees      : 0\r\n    erreurs de sequence  : 0\r\n    delais expires       : 0\r\n  Emission ISO-TP\r\n    messages emis        : 18\r\n    trames emises        : 18\r\n\r\n[DEFAULT | LOCKED] > "]
[30.626155, "o", "quit\r\n\r\n"]
[32.731566, "o", "\r\n════════════════════════════════════════════════════════════\r\n  4. Injection de fautes\r\n════════════════════════════════════════════════════════════\r\n"]
[33.933593, "o", "  Onze scenarios cibles. Toutes les 25 attaques, une requete\r\n  parfaitement valide doit obtenir la reponse exacte attendue.\r\n"]
[43.236115, "o", "  =============================================\r\n   Injecteur de fautes CAN\r\n  =============================================\r\n   interface : vcan0\r\n   cycles    : 100\r\n   graine    : 0x0BADC0DE\r\n   scenarios : 11\r\n  \r\n  ECU present et fonctionnel. Debut de la campagne.\r\n  \r\n        25 attaques ... ECU toujours operationnel\r\n        50 attaques ... ECU toujours operationnel\r\n        75 attaques ... ECU toujours operationnel\r\n       100 attaques ... ECU toujours operationnel\r\n  \r\n  --- Repartition des scenarios ---\r\n    numero de sequence incorrect           10\r\n    Consecutive Frame manquante             4\r\n    longueur annoncee demesuree            11\r\n    Single Frame tronquee                  14\r\n    Consecutive Frames orphelines           8\r\n    type de trame inexistant                7\r\n    transferts entrelaces                   6\r\n    requete UDS malformee                  12\r\n    cle de securite sans graine            10\r\n    ECUReset sans deverrouillage           11\r\n    rafale de trames aleatoires             7\r\n  \r\n  --- Resultats ---\r\n    attaques jouees        : 100\r\n    trames emises          : 457\r\n    sondes de vitalite     : 6\r\n    sondes reussies        : 6\r\n    sondes echouees        : 0\r\n    ECUReset non autorises : 0\r\n  =============================================\r\n"]
[44.239253, "o", "\r\n════════════════════════════════════════════════════════════\r\n  5. Validation croisee contre la pile ISO-TP du noyau Linux\r\n════════════════════════════════════════════════════════════\r\n"]
[45.441936, "o", "  Nos tests prouvent que notre emetteur et notre recepteur\r\n  se comprennent. Le noyau est un arbitre independant.\r\n"]
[47.951299, "o", "  =============================================\r\n   Validation croisee contre ISO-TP du noyau\r\n  =============================================\r\n   interface : vcan0\r\n  \r\n"]
[49.463571, "o", "  Pile noyau operationnelle.\r\n"]
[50.967276, "o", "  ECU virtuel demarre (pid 38346).\r\n  \r\n  [1] Requete Single Frame emise par le noyau\r\n"]
[53.483646, "o", "    OK     DiagnosticSessionControl : 50 03 + sessionParameterRecord\r\n  \r\n  [2] Reponse multi-trames de notre ECU, reassemblee par le noyau\r\n"]
[56.997909, "o", "    OK     ReadDataByIdentifier VIN : 20 octets sur plusieurs trames\r\n  \r\n  [3] Message multi-trames emis par le noyau, reassemble par nous\r\n"]
[59.109231, "o", "    OK     les 30 octets emis par le noyau sont reassembles\r\n"]
[59.109952, "o", "    OK     refus UDS apres reassemblage (NRC 0x13)\r\n  \r\n  [4] Reponse negative transportee jusqu'au noyau\r\n"]
[61.625872, "o", "    OK     service inconnu : 7F 99 11\r\n  \r\n  =============================================\r\n   5 verification(s), 0 echec(s)\r\n  =============================================\r\n"]
[63.629803, "o", "\r\n════════════════════════════════════════════════════════════\r\n  6. Fuzzing des analyseurs, en memoire\r\n════════════════════════════════════════════════════════════\r\n"]
[65.124184, "o", "  =============================================\r\n   Fuzzing des analyseurs\r\n  =============================================\r\n   iterations : 300000\r\n   graine     : 0x00C0FFEE\r\n  \r\n  --- Resultats ---\r\n    cas joues              : 300000\r\n    trames ISO-TP          : 1949574\r\n    messages reassembles   : 115187\r\n    erreurs de sequence    : 148354\r\n    debordements refuses   : 40\r\n    delais expires         : 27219\r\n    requetes UDS           : 300000\r\n    reponses positives     : 828\r\n    reponses negatives     : 290442\r\n  \r\n    ANOMALIES              : 0\r\n  =============================================\r\n"]
[67.127443, "o", "\r\n════════════════════════════════════════════════════════════\r\n  Fin\r\n════════════════════════════════════════════════════════════\r\n"]
[68.330498, "o", "  github.com/Bennmane27/hardened-diagnostic-gateway\r\n"]
